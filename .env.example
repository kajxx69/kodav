# =====================================================================
# KODAV — variables d'environnement
# Copiez ce fichier en `.env` (à la racine) et remplissez les valeurs.
# Le fichier `.env` n'est jamais commité.
# =====================================================================

# --- Général -----------------------------------------------------------
# development | test | production
NODE_ENV=development
# Port de l'API Express
PORT=4000
# URL publique de l'API (liens dans les emails, PDF)
API_URL=http://localhost:4000
# URL publique du front (liens dans les emails, redirections)
CLIENT_URL=http://localhost:5173
# Origines autorisées par CORS, séparées par des virgules
CORS_ORIGINS=http://localhost:5173
# Fuseau horaire métier
TZ=Africa/Abidjan
# Niveau de logs pino : fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Base de données (MongoDB Atlas) -------------------------------------
# Atlas > Database > Connect > Drivers. Ajoutez le nom de la base après le /.
# Exemple : mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/kodav?retryWrites=true&w=majority
MONGODB_URI=

# --- Authentification ----------------------------------------------------
# Secrets longs et aléatoires (au moins 32 caractères), différents l'un de l'autre.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Durées de vie
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Cookie du refresh token : strict si front et API partagent le même domaine
# (ex. kodav.ci et api.kodav.ci), none s'ils sont sur deux domaines différents.
COOKIE_SAMESITE=strict
# Clé AES-256 (32 octets en base64) pour chiffrer les clés de licence conservées
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Emails (SMTP) -------------------------------------------------------
# Laisser SMTP_HOST vide en développement : les emails sont écrits dans les logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché
MAIL_FROM="KODAV Technologies <contact@kodav.ci>"

# --- Fichiers (Cloudinary) -----------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Sans Cloudinary (développement), les fichiers sont écrits dans ce dossier de l'API.
UPLOAD_DIR=uploads

# --- Anti-spam (Cloudflare Turnstile, optionnel) --------------------------
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
# Clé publique, lue par le front
VITE_TURNSTILE_SITE_KEY=

# --- Seed (npm run seed) -------------------------------------------------
SEED_ADMIN_EMAIL=admin@kodav.ci
# Mot de passe fort, au moins 12 caractères
SEED_ADMIN_PASSWORD=
# Mot de passe des comptes de test (technicien et deux clients, emails en @kodav.test).
# Laisser vide en production : aucun compte de test n'est alors créé.
SEED_TEST_PASSWORD=

# --- Front (exposé au navigateur : rien de secret ici) --------------------
VITE_API_URL=http://localhost:4000/api/v1
# URL publique du site (balises canoniques, Open Graph, sitemap)
VITE_SITE_URL=http://localhost:5173
