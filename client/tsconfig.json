{
  "extends": "../tsconfig.base.json",
  "include": ["src", ".react-router/types/**/*", "*.ts"],
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "noEmit": true,
    "declaration": false,
    "paths": { "~/*": ["./src/*"] }
  }
}
